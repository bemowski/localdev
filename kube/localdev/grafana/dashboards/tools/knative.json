      "targets": [
        {
          "expr": "sum by (kn_revision_name) (kn_revision_concurrency_stable{k8s_namespace_name=~\"$namespace\", kn_service_name=~\"$service\"})",
          "legendFormat": "{{kn_revision_name}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "max by (kn_revision_name) (kn_revision_concurrency_target{k8s_namespace_name=~\"$namespace\", kn_service_name=~\"$service\"})",
          "legendFormat": "{{kn_revision_name}} target",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
