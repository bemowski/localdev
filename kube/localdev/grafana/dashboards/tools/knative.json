    {
      "id": 8,
      "type": "timeseries",
      "title": "Pods: desired vs actual (per revision)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (kn_revision_name) (kn_revision_pods_desired{k8s_namespace_name=~\"$namespace\", kn_service_name=~\"$service\"})",
          "legendFormat": "{{kn_revision_name}} desired",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "sum by (kn_revision_name) (kn_revision_pods_count{k8s_namespace_name=~\"$namespace\", kn_service_name=~\"$service\"})",
          "legendFormat": "{{kn_revision_name}} actual",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Concurrency (stable window) vs target",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
