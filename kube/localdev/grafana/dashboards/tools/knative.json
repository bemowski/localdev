      "targets": [
        {
          "expr": "sum by (job, http_response_status_code) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=~\"$namespace\", job=~\"$service\", kn_route_tag!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{job}} {{http_response_status_code}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
