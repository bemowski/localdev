          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=~\"$namespace\", job=~\"$service\", kn_route_tag!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{job}}",
